{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Resource v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "dimensionId",
    "version",
    "name",
    "status",
    "parameters",
    "source",
    "license",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "dimensionId": {
      "enum": [
        "style",
        "theme",
        "color",
        "typography",
        "spacing",
        "radius",
        "border",
        "background",
        "surface",
        "shadow",
        "effects",
        "imagery",
        "icons",
        "layout",
        "navigation",
        "density",
        "components",
        "visualization",
        "interaction",
        "motion"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "reference",
        "available",
        "deprecated"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "internal-proposal",
            "builtin",
            "external",
            "user"
          ]
        },
        "url": {
          "type": "string"
        },
        "upstreamVersion": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending-review",
            "approved",
            "restricted"
          ]
        },
        "identifier": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "requires",
        "conflicts"
      ],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        }
      }
    }
  }
}