{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yeyunbingyang/UI-Design-Studio/blob/main/design-system/v2/design-dimension-mapping.schema.json",
  "title": "DESIGN.md to Canonical Design Dimension Mapping",
  "type": "object",
  "required": [
    "schemaVersion",
    "mappingVersion",
    "status",
    "model",
    "compatibility",
    "dimensions",
    "extendedChapters",
    "coreDomains",
    "extensions",
    "crossCuttingRules",
    "invariants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mappingVersion": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed-canonical-mapping",
        "active-canonical-mapping"
      ]
    },
    "model": {
      "type": "string"
    },
    "modelZh": {
      "type": "string"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "canonicalDimensionIds",
        "domainMetadata",
        "resourceCatalog",
        "resourceRegistry",
        "rule"
      ],
      "properties": {
        "canonicalDimensionIds": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "domainMetadata": {
          "type": "string"
        },
        "resourceCatalog": {
          "type": "string"
        },
        "resourceRegistry": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "minProperties": 20,
      "maxProperties": 20,
      "propertyNames": {
        "enum": [
          "style",
          "theme",
          "color",
          "typography",
          "spacing",
          "radius",
          "border",
          "background",
          "surface",
          "shadow",
          "effects",
          "imagery",
          "icons",
          "layout",
          "navigation",
          "density",
          "components",
          "visualization",
          "interaction",
          "motion"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "chapters",
          "primaryChapter",
          "domains",
          "responsibility"
        ],
        "properties": {
          "chapters": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-6])$"
            }
          },
          "primaryChapter": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-6])$"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "responsibility": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "extendedChapters": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nameEn",
          "nameZh",
          "dimensions",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-6])$"
          },
          "nameEn": {
            "type": "string"
          },
          "nameZh": {
            "type": "string"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "coreDomains": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nameEn",
          "nameZh",
          "dimensions",
          "primaryDimensions",
          "chapters"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "nameZh": {
            "type": "string"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "primaryDimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-6])$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "chapters",
          "dimensions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-6])$"
            },
            "uniqueItems": true
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "crossCuttingRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "appliesTo",
          "ownsTokens"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "appliesTo": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "ownsTokens": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
