{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Preset v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "selections",
    "lockedDimensions",
    "overrides"
