    "selections": {
      "type": "object",
      "required": [
        "style",
        "theme",
        "color",
        "typography",
        "spacing",
        "radius",
        "border",
        "background",
        "surface",
        "shadow",
        "effects",
        "imagery",
        "icons",
        "layout",
        "navigation",
        "density",
        "components",
        "visualization",
        "interaction",
        "motion"
