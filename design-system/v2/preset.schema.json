      "type": "object"
    },
    "migration": {
      "type": "object",
      "required": [
        "sourceVersion",
        "original",
        "warnings"
      ],
      "properties": {
        "sourceVersion": {
          "const": 1
        },
        "original": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
